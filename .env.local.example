# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real keys.

# --- Firebase Authentication + Firestore (client-side) ---
# Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# --- AI services (server-side / route handlers only, never NEXT_PUBLIC_) ---
# Provide GEMINI_API_KEY (recommended, used first) and/or OPENAI_API_KEY.
# If neither is set, CollabAI automatically falls back to its local
# deterministic matching + writing engine, so the app always works.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here   # alternate name, also read
OPENAI_API_KEY=your_openai_api_key_here
